#!/usr/bin/python3
"""Fake systemctl: records how it was called. `is-active` answers from hw.json."""
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _common as c

c.log_call("systemctl")
if "is-active" in sys.argv[1:]:
    sys.exit(0 if sys.argv[-1] in c.load().get("active", []) else 3)
