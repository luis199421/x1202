#!/usr/bin/python3
"""Fake apt-get. Records every call. `install FILE.deb` unpacks the package into
the (test) system and runs its install step like dpkg does; `remove` / `purge`
run its removal steps and delete its files. Other packages are only recorded."""
import json
import os
import shutil
import subprocess
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _common as c

c.log_call("apt-get")
args, skip = [], False
for a in sys.argv[1:]:
    if skip:
        skip = False
    elif a == "-o":
        skip = True
    elif not a.startswith("-"):
        args.append(a)
if not args:
    sys.exit(0)
cmd, names = args[0], args[1:]


def state():
    return c.load().get("dpkg", {})


def save_state(d):
    hw = c.load()
    hw["dpkg"] = d
    c.save(hw)


def control_dir(pkg):
    return os.path.join(c.STATE, "control-" + pkg)


def run_script(pkg, name, *a):
    script = os.path.join(control_dir(pkg), name)
    if os.path.exists(script):
        r = subprocess.run([script, *a])
        if r.returncode:
            sys.exit(100)


if cmd == "install":
    for deb in names:
        if not deb.endswith(".deb"):
            continue
        pkg, ver = subprocess.run(["dpkg-deb", "-f", deb, "Package", "Version"],
                                  capture_output=True, text=True, check=True).stdout.split()[1::2]
        installed = state()
        old = installed.get(pkg)
        if old:
            run_script(pkg, "prerm", "upgrade", ver)
        listing = subprocess.run(["dpkg-deb", "-c", deb], capture_output=True, text=True,
                                 check=True).stdout.splitlines()
        files = [line.split()[-1][1:] for line in listing if not line.startswith("d")]
        subprocess.run(["dpkg-deb", "-x", deb, "/"], check=True)
        shutil.rmtree(control_dir(pkg), ignore_errors=True)
        subprocess.run(["dpkg-deb", "-e", deb, control_dir(pkg)], check=True)
        installed[pkg] = {"version": ver, "files": files}
        save_state(installed)
        run_script(pkg, "postinst", "configure", *([old["version"]] if old else []))
elif cmd in ("remove", "purge"):
    installed = state()
    for pkg in names:
        if pkg not in installed:
            continue
        run_script(pkg, "prerm", "remove")
        for f in installed[pkg]["files"]:
            if os.path.isfile(f):
                os.remove(f)
        run_script(pkg, "postrm", cmd)
        del installed[pkg]
        save_state(installed)
