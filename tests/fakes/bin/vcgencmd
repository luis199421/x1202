#!/usr/bin/python3
"""Fake vcgencmd: get_throttled and pmic_read_adc (Pi 5 output format)."""
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _common as c

hw = c.load()
cmd = sys.argv[1:2]
if cmd == ["get_throttled"]:
    print(f"throttled={hw.get('throttled', '0x0')}")
elif cmd == ["pmic_read_adc"]:
    print("""   3V7_WL_SW_A current(0)=0.00390372A
   3V3_SYS_A current(1)=0.06636324A
   VDD_CORE_A current(7)=1.00000000A
   EXT5V_A current(8)=0.00000000A
   3V7_WL_SW_V volt(8)=3.71048200V
   3V3_SYS_V volt(9)=3.31136000V
   VDD_CORE_V volt(15)=0.80000000V
   EXT5V_V volt(24)=5.13996000V""")
elif cmd == ["measure_clock"] and sys.argv[2:3] == ["v3d"]:
    print(f"frequency(0)={hw.get('v3d_mhz', 960) * 1000000}")
else:
    sys.exit(1)
